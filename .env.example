# Vite (local .env.local)
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
VITE_CLERK_PUBLISHABLE_KEY=

# Set these on the Convex deployment with `bunx convex env set`, not in Vite.
# CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev
# CLIENT_ORIGIN=http://localhost:5178
# CLIENT_PREVIEW_ORIGIN=https://writing-assistant-*-your-team.vercel.app
# One deployment-level key used only to encrypt user credentials at rest.
# Users enter their individual OpenRouter keys in the app's Settings page.
# CREDENTIAL_ENCRYPTION_KEY=<base64-encoded 32-byte key>

# Playwright Clerk testing (shell or CI secrets)
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# E2E_CLERK_USER_EMAIL=writer+clerk_test@example.com
